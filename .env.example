# ============================================================
# SmartHire Pro — Local Dev Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER commit actual credentials.
# ============================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT (generate a strong 256-bit secret)
JWT_SECRET=replace_with_a_strong_256bit_secret_key_minimum_32_chars
JWT_EXPIRATION_MS=86400000

# Mail (use Gmail App Password, NOT your account password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# File Storage
FILE_UPLOAD_DIR=./uploads/resumes
